{
  "info": {
    "name": "Doce Gestão — Demonstração da Avaliação Final",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Dados fictícios para demonstrar CRUD, relacionamentos e regras. Execute em ordem. O final remove somente os registros criados por esta execução. Ajuste baseUrl para a porta da sua API."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3200"
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "deliveryDate",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 · Criar cliente fictício",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/customers",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cliente apresentação {{runId}}\",\n  \"phone\": \"41999990000\",\n  \"email\": \"demo@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"customerId\", pm.response.json().id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"runId\", Date.now().toString());",
              "pm.collectionVariables.set(\"deliveryDate\", new Date(Date.now()+86400000).toISOString());",
              "for (const key of [\"customerId\",\"orderId\",\"paymentId\"]) pm.collectionVariables.set(key, \"\");"
            ]
          }
        }
      ]
    },
